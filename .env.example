# Copie para .env e ajuste.

# Nome exibido na plataforma (nome comercial ainda a definir)
APP_NAME=Estuvia

PORT=3000

# Em produção use NODE_ENV=production (ativa cookie Secure, HSTS e exige JWT_SECRET)
NODE_ENV=development

# Segredo das sessões. OBRIGATÓRIO em produção, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Assistente de IA (opcional). Sem chave, o Guia usa a base local (modo offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Origem permitida em produção, atrás de proxy (ex.: https://app.seudominio.com)
ALLOWED_ORIGIN=

# Caminho da base local (padrão: data/db.json)
# DATA_FILE=

# Painel do administrador (#/admin): quem acessa, cadastros, eventos de segurança, suspensão de contas.
# A conta é criada na inicialização; trocar ADMIN_PASSWORD e reiniciar troca a senha (mínimo 8 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Moderadores da comunidade (verificam oportunidades e analisam denúncias), separados por vírgula
MODERATOR_EMAILS=

# Pasta das imagens da comunidade (padrão: data/media)
# MEDIA_DIR=

# Carteira de documentos: arquivos cifrados (AES-256-GCM) em data/docfiles.
# Em produção defina uma chave própria (≥ 32 caracteres) e guarde-a com backup: sem ela os arquivos ficam ilegíveis.
# DOCUMENTS_KEY=
# DOCS_DIR=

# Radar de Oportunidades
# Equipe que acessa o painel #/radar/admin (revisão, correções), separada por vírgula
RADAR_ADMIN_EMAILS=
# "off" desliga o atualizador automático de fontes oficiais
# RADAR_SCHEDULER=
# Arquivo da base do Radar (padrão: data/radar.json)
# RADAR_DATA_FILE=

# Mentor Estuvia (docs/15-mentor.md)
# Provedor de IA do Mentor: none (padrão — Modo Guiado, sem custo) | anthropic | openai-compatible
# MENTOR_PROVIDER=none
# Modelo do provedor (anthropic: claude-opus-5-5; openai-compatible: nome do modelo no servidor)
# MENTOR_MODEL=
# Só para openai-compatible (OpenAI, Ollama, LM Studio, vLLM…): URL base e chave, se houver
# MENTOR_BASE_URL=http://localhost:11434/v1
# MENTOR_API_KEY=
# "1" registra no console cada ferramenta usada pelo Mentor
# MENTOR_DEBUG=
