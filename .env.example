# Copie para .env e ajuste.

# Nome exibido na plataforma (nome comercial ainda a definir)
APP_NAME=Estuvia

PORT=3000

# Em produção use NODE_ENV=production (ativa cookie Secure, HSTS e exige JWT_SECRET)
NODE_ENV=development

# Segredo das sessões. OBRIGATÓRIO em produção, mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Assistente de IA (opcional). Sem chave, o Guia usa a base local (modo offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Origem pública em produção, atrás de proxy (ex.: https://app.seudominio.com).
# OBRIGATÓRIA em produção: usada na proteção CSRF e nos links de recuperação de senha.
ALLOWED_ORIGIN=

# E-mail transacional (recuperação de senha) via Resend (resend.com → API Keys; verifique o domínio do remetente).
# Sem estas variáveis: em desenvolvimento o link aparece no console; em produção a recuperação de senha fica indisponível.
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: Estuvia <no-reply@seudominio.com>
EMAIL_FROM=

# Caminho da base local (padrão: data/db.json)
# DATA_FILE=

# Persistência do app. "json" mantém os arquivos locais; use "supabase" depois de aplicar supabase/schema.sql.
DB_PROVIDER=json
SUPABASE_URL=https://pomtzhzoxwwnxztwwmft.supabase.co
# Chave secret do Supabase (sb_secret_...): somente servidor, nunca NEXT_PUBLIC e nunca no Git.
SUPABASE_SECRET_KEY=
# Compatibilidade com projetos que ainda usam a chave antiga de servidor (service_role).
# SUPABASE_SERVICE_ROLE_KEY=

# Arquivos (documentos cifrados e imagens da comunidade): "local" (disco) ou "supabase" (Storage).
# Sem definir, segue DB_PROVIDER (supabase quando o banco é Supabase — obrigatório na Vercel,
# onde o disco é efêmero e somente leitura). Os buckets privados são criados automaticamente:
# estuvia-documents, estuvia-community e estuvia-meta.
# STORAGE_PROVIDER=supabase
# SUPABASE_DOCS_BUCKET=estuvia-documents
# SUPABASE_MEDIA_BUCKET=estuvia-community
# SUPABASE_META_BUCKET=estuvia-meta

# Painel do administrador (#/admin): quem acessa, cadastros, eventos de segurança, suspensão de contas.
# A conta é criada na inicialização; trocar ADMIN_PASSWORD e reiniciar troca a senha
# (mínimo 8 caracteres em desenvolvimento, 12 em produção, com letras e números). O e-mail fica reservado.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Moderadores da comunidade (verificam oportunidades e analisam denúncias), separados por vírgula.
# SÓ EM DESENVOLVIMENTO: em produção é ignorado; conceda o papel no painel admin (aluno → Papel).
MODERATOR_EMAILS=

# Pasta das imagens da comunidade (padrão: data/media)
# MEDIA_DIR=

# Carteira de documentos: arquivos cifrados (AES-256-GCM) em data/docfiles.
# OBRIGATÓRIA em produção (≥ 32 caracteres; o servidor não sobe sem ela). Guarde com backup: sem ela os arquivos ficam ilegíveis.
# DOCUMENTS_KEY=
# DOCS_DIR=
# Revisões editoriais da carteira (aviso, data, fontes por documento). Padrão: data/document-rules.json
# DOC_RULES_FILE=

# Radar de Oportunidades
# Equipe que acessa o painel #/radar/admin (revisão, correções), separada por vírgula.
# SÓ EM DESENVOLVIMENTO: em produção use o papel "Equipe do Radar" no painel admin.
RADAR_ADMIN_EMAILS=
# "off" desliga o atualizador automático de fontes oficiais
# RADAR_SCHEDULER=
# Arquivo da base do Radar (padrão: data/radar.json)
# RADAR_DATA_FILE=

# Mentor Estuvia (docs/15-mentor.md)
# Provedor de IA do Mentor: none (padrão — Modo Guiado, sem custo) | anthropic | openai-compatible
# MENTOR_PROVIDER=none
# Modelo do provedor (anthropic: claude-opus-5-5; openai-compatible: nome do modelo no servidor)
# MENTOR_MODEL=
# Só para openai-compatible (OpenAI, Ollama, LM Studio, vLLM…): URL base e chave, se houver
# MENTOR_BASE_URL=http://localhost:11434/v1
# MENTOR_API_KEY=
# "1" registra no console cada ferramenta usada pelo Mentor
# MENTOR_DEBUG=
# Teto diário de tokens de IA por estudante (Mentor + Assistente somados). Padrão 300000; 0 desliga o teto.
# Ao atingir, o estudante continua no Modo Guiado / base local, com aviso de que está sem IA generativa.
# AI_DAILY_TOKENS_PER_USER=300000
# Tempo máximo de UMA chamada ao modelo (padrão 60000 ms) e de uma mensagem inteira do Mentor (padrão 120000 ms)
# MENTOR_TIMEOUT_MS=60000
# MENTOR_DEADLINE_MS=120000

# ---------- Pesquisa na web, vídeos e preços (tudo GRATUITO) ----------
# Pesquisa na web do Mentor: Canal UGR (oficial), GDELT (imprensa) e Wikipédia — não precisam de chave.
# Vídeos/aulas no chat: chave gratuita da YouTube Data API v3 (Google Cloud → APIs → YouTube Data API v3 →
# Credenciais → Chave de API; não pede cartão; cota grátis ≈ 100 buscas/dia). Sem chave, o Mentor mostra
# só o link da busca no YouTube (nunca inventa vídeos).
# YOUTUBE_API_KEY=
# Preços de passagens + alerta de preço: token gratuito do programa de afiliados Travelpayouts
# (travelpayouts.com → cadastro → Perfil → API token). Sem token, a seção "Preços vistos agora" explica que está desligada.
# TRAVELPAYOUTS_TOKEN=

# ---------- Avançado ----------
# Alternativa à ANTHROPIC_API_KEY (token OAuth/gateway), raramente necessária.
# ANTHROPIC_AUTH_TOKEN=
# Câmbio automático (BCE via Frankfurter, padrão). "off" desliga: sem taxa automática.
# FX_PROVIDER=frankfurter
# Multiplica os limites de requisição (rate limit). Padrão 1; só para suítes de teste.
# RATE_LIMIT_SCALE=1
